# ==========================================
# CMake Build Directory & Dependencies
# ==========================================
# Ignores the CMake build folder (out-of-source builds)
build/
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile

# ==========================================
# C++ Build Outputs & Binaries
# ==========================================
# Exclude compiled binaries and intermediate build files
bin/
*.exe
*.dll
*.so
*.dylib

# MSVC & MinGW intermediate files
*.obj
*.o
*.ilk
*.pdb
*.idb
*.exp

# ==========================================
# IDE & Tooling Configs
# ==========================================
# Visual Studio
.vs/
Debug/
Release/
x64/
x86/
*.sln
*.vcxproj
*.vcxproj.filters
*.vcxproj.user
*.tlog
*.suo

# VS Code
.vscode/

# CLion
.idea/
cmake-build-debug/
cmake-build-release/

# ==========================================
# Generated Rendered Output Files
# ==========================================
*.ppm
*.bmp

# ==========================================
# Operating System Files
# ==========================================
.DS_Store
Thumbs.db
desktop.ini
ideas.md
.gitignore
